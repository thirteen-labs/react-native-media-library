{
  "name": "@obsidian_north/react-native-mediastore",
  "version": "3.6.0",
  "description": "Universal high-performance media indexing library for Android (MediaStore) and iOS (Photos Framework)",
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "license": "MIT",
  "keywords": [
    "react-native",
    "mediastore",
    "android",
    "ios",
    "media",
    "indexing",
    "audio",
    "video",
    "images",
    "documents",
    "photos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Northern-Obsidian/react-native-media-library.git"
  },
  "bugs": {
    "url": "https://github.com/Northern-Obsidian/react-native-media-library/issues"
  },
  "author": "cadmus_labs",
  "homepage": "https://github.com/Northern-Obsidian/react-native-media-library",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf build",
    "watch": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "sync-version": "node scripts/sync-version.js"
  },
  "files": [
    "build",
    "src",
    "android",
    "ios",
    "react-native.config.js",
    "!**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  }
}
